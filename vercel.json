{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run auth:generate && npm run build",
      "outputDirectory": "dist",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/index.html" }
      ]
    },
    "api": {
      "root": ".",
      "framework": "express",
      "entrypoint": "api/[...path].js",
      "bindings": [
        {
          "type": "service",
          "service": "stats",
          "format": "url",
          "env": "NINTH_STATS_INTERNAL_URL"
        }
      ]
    },
    "stats": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/api/stats", "destination": { "service": "stats" } },
    { "source": "/api/stats/(.*)", "destination": { "service": "stats" } },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
