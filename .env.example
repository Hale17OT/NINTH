MLB_STATS_URL=http://127.0.0.1:3002
MLB_STATS_PORT=3002
NINTH_PROJECTION_MONITOR_ENABLED=1
NINTH_PREGAME_REFRESH_SECONDS=300
NINTH_LIVE_REFRESH_SECONDS=10
NINTH_MELBET_REFRESH_SECONDS=300
NINTH_MELBET_NEAR_START_SECONDS=60
NINTH_MELBET_NEAR_START_MINUTES=30
NINTH_MELBET_MAX_BACKOFF_SECONDS=1800
NINTH_MAINTENANCE_HOUR=3
NINTH_MAINTENANCE_MINUTE=15
NINTH_READINESS_HOUR=3
NINTH_READINESS_MINUTE=45
NINTH_GAME_DISCOVERY_SECONDS=60
NINTH_PREGAME_MONITOR_HOURS=24
NINTH_PLAYER_PROP_REFRESH_SECONDS=300
THE_ODDS_API_KEY=
ODDS_REGION=us
ODDS_FORMAT=american

# Optional free-account tokens. Football, NFL, NBA and Esports collectors run
# without them. Esports uses Liquipedia's rate-limited MediaWiki API.
NINTH_FOOTBALL_DATA_TOKEN=
RIOT_API_KEY=
GRID_API_KEY=
THESPORTSDB_API_KEY=123

# PostgreSQL-backed accounts and user-owned data
DATABASE_URL=postgresql://ninth:replace_me@127.0.0.1:54329/ninth?schema=public
TEST_DATABASE_URL=postgresql://ninth:replace_me@127.0.0.1:54329/ninth_test?schema=public
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
TRUSTED_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_SECRET=
SESSION_ABSOLUTE_DAYS=30
SESSION_IDLE_HOURS=168
SESSION_SHORT_HOURS=24
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Google Web OAuth client (openid, email and profile only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Replaceable transactional-email transport. Gmail SMTP may be used temporarily;
# the app password belongs only in the ignored .env or deployment secret store.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NINTH <account@example.com>

# Optional development seed. Never use production credentials here.
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=
DEV_SEED_DISPLAY_NAME=NINTH Developer
LEGACY_OWNER_EMAIL=
