{
  "name": "diamond-intel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:stats\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/src/server.js",
    "dev:stats": "python stats-service/app.py",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --strictPort",
    "start": "concurrently -k \"python stats-service/app.py\" \"node server/src/server.js\" \"vite preview --host 0.0.0.0 --strictPort\"",
    "start:client": "vite preview --host 0.0.0.0 --strictPort",
    "start:server": "node server/src/server.js",
    "start:stats": "python stats-service/app.py",
    "daily": "npm run build && npm start",
    "audit:multisport": "python -m ml.multisport.backfill",
    "backfill:multisport": "python -m ml.multisport.backfill --refresh-sources",
    "refresh:readiness": "python -m ml.multisport.refresh_readiness"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "hyparquet": "^1.28.1",
    "lucide-vue-next": "^0.468.0",
    "motion-v": "^2.3.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
